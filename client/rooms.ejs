<style>
    *{
        margin: 0;
        padding: 0;
    }
    body{
        width:100vw;
        height: 100vh;
        overflow: hidden;
    }
    .mask{
        position: fixed;
        z-index: 9999;
        width: 90vw;
        height: 90vh;
        transform: translate(-50%,-50%);
        top: 50%;
        left: 50%;
        background-color: rgba(0,0,0,.6);
        padding: 20px 10vw;
        box-sizing: border-box;
        /*display: none;*/
    }
    .mask .h1{
        margin-bottom: 20px;
        display: flex;
        font-size: 30px;
        height: 40px;
        line-height: 40px;
    }
    .mask .h2{
        margin-bottom: 20px;
        display: flex;
        font-size: 25px;
        height: 40px;
        line-height: 40px;
    }
    .mask .h1>div{
        width: 50%;
        height: 40px;
        line-height: 40px;
    }
    .mask .h1>.new{
        font-weight: 800;
        text-align: right;
        cursor: pointer;
    }
    .mask li{
        cursor: pointer;
        list-style: none;
        width: 70vw;
        height: 50px;
        padding: 0 15px;
        font-size: 20px;
        border-radius: 5px;
        line-height: 50px;
        box-sizing: border-box;
        background-color: blue;
        display: flex;
        margin-bottom: 10px;
        background-image: linear-gradient(135deg,#8BC6EC,#9599E2);
    }
    .mask li>div{
        width: 50%;
        height: 100%;color: #333;
    }
    .mask li>div:nth-child(2){
        text-align: right;
        color: #fff;
    }
    .shapes,.colors{
        display: flex;
    }
    .shape,.color{
        width: 22%;
        height: 100%;
        font-size: 20px;
        cursor: pointer;
    }
    .active{
        color: red;
    }
    .users{
        position: fixed;
        top: 0;
        right: 0;
        font-size: 16px;
        text-align: right;
        background-color: rgba(0,0,0,.3);
        display: none;
    }
    .blue{
        color: blue;
        font-size: 20px;
        font-weight: 900;
    }
    .green{
        color: green;
        font-size: 20px;
        font-weight: 900;
    }
    .red{
        color: red;
        font-size: 20px;
        font-weight: 900;
    }
    .black{
        color: #eee;
        font-size: 20px;
        font-weight: 900;
    }
    .chat{
        max-height: 50vh;
        overflow: hidden;
        min-height:10vh;
        min-width: 10vw;
        position: fixed;
        left: 10px;
        bottom: 30px;
        display: none;
        transform: translate(0,0);
    }
    .chat-input{
        position: fixed;
        left: 10px;
        bottom: 10px;
        background-color: transparent;
        border: 0px;
        /*color:white;*/
    }
    .chat-input:focus{
        outline: none;
    }
</style>
